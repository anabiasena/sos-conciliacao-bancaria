# Dominio ou IP do seu servidor n8n (ex.: https://n8n.seudominio.com)
N8N_BASE_URL=https://SEU-DOMINIO-N8N

# ID do formulario de importacao de extratos no n8n
N8N_IMPORT_FORM_ID=SEU-FORM-ID

# Token de integracao do Notion usado pelas credenciais do n8n
NOTION_INTEGRATION_TOKEN=

# URLs (ou IDs) das bases do Notion
NOTION_DB_MOVIMENTACOES=
NOTION_DB_CONCILIACAO=
NOTION_DB_CONTAS_A_PAGAR=
NOTION_DB_CONTAS_A_RECEBER=
